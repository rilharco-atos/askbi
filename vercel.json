{
  "version": 2,
  "regions": ["fra1"],
  "builds": [
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "index.html",
          "content.json",
          "pages/**/*",
          "assets/**/*",
          "admin/**/*"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1",
      "headers": {
        "Cache-Control": "public, max-age=3600, stale-while-revalidate=86400"
      }
    },
    { "src": "/(.*)", "dest": "/server.js" }
  ]
}
