{
  "name": "asbki-covilha",
  "version": "1.0.0",
  "description": "ASBKI Covilhã — Website com CMS",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test \"tests/**/*.test.js\" \"tests/**/*.test.mjs\"",
    "e2e": "node tests/e2e.mjs",
    "legibility": "node tests/legibility.mjs",
    "perf": "node tests/perf.mjs",
    "audit": "npm run legibility && npm run perf",
    "check:content": "node scripts/check-content.mjs",
    "previews": "node scripts/previews.mjs",
    "leads:prune": "node scripts/leads-prune.mjs",
    "icons:generate": "python scripts/generate_icons.py"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "multer": "^2.3.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.14.0"
  }
}
