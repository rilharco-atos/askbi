# Porta local (a Vercel define a sua própria em produção)
PORT=3000

# ─── Autenticação do painel de administração ────────────────────────────
# Preferido: hash scrypt gerado com
#   node -e "console.log(require('./server/auth').hashPassword('a-tua-password'))"
ADMIN_PASSWORD_HASH=
# Compatibilidade (dev/legado) — password em claro; nunca usar em produção
ADMIN_PASSWORD=muda-me
# Opcional: segredo explícito para assinar os tokens de sessão do admin.
# Sem esta variável, deriva de ADMIN_PASSWORD_HASH ou de ADMIN_PASSWORD.
ADMIN_TOKEN_SECRET=

# ─── Conteúdo e uploads (Vercel Blob) ────────────────────────────────────
# Sem esta variável, o conteúdo e os uploads ficam em disco local
ASBKI_READ_WRITE_TOKEN=

# ─── Leads (marcações e contactos) ───────────────────────────────────────
# Sem esta variável, os leads ficam em disco local (data/leads/, fora do git)
LEADS_BLOB_READ_WRITE_TOKEN=
# Resend (envio de e-mail de notificação de leads) — região UE configurada na conta
RESEND_API_KEY=
LEADS_TO_EMAIL=geral@asbki-covilha.pt
LEADS_FROM_EMAIL=notificacoes@asbki-covilha.pt

# ─── SEO / metadados ─────────────────────────────────────────────────────
# Base pública do site para canonical/OG/sitemap; sem esta variável usa
# https:// + o host do pedido
SITE_URL=https://asbki-covilha.pt

# ─── Analytics (opcional, respeita a privacidade) ────────────────────────
# Sem esta variável, nenhum script de analytics é carregado
PLAUSIBLE_DOMAIN=

# production ativa o Strict-Transport-Security e omite detalhes de erro
NODE_ENV=development
